# One JSON per configuration. results/results_*.json is the merged form the analysis
# scripts read and is tracked; the cache is reproducible from it being deleted and rerun,
# and is 300+ files
results/cache/

# sweep stdout, regenerated by rerun_all.sh
logs/

# figures are generated by make_writeup.sh. The PDFs are tracked, because the write-up
# needs them to build; the PNGs are previews of the same thing
figs/*.png

__pycache__/
*.pyc
